.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.zip
# Submission artifacts ARE tracked: they are the per-assignment record of what was
# graded, and the drive is exFAT with no journaling, so git is their only backup.
!submissions/**/*.zip
!submissions/**/*.jpg

# macOS AppleDouble sidecars. MUST stay last: the drive is exFAT, so macOS writes a
# `._name.ext` sibling for every file, and `._x.zip` / `._x.jpg` would otherwise be
# re-included by the negations above.
._*
